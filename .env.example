# Vetta - Environment Configuration Template

# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Settings
# Leave unset or empty to use local embedded PGLite (WASM Postgres with automatic migrations)
# Set to a standard PostgreSQL connection string for production or external DB (e.g. Neon, Supabase, RDS)
# DATABASE_URL=postgresql://user:password@localhost:5432/vetta

# Authentication Settings (Better Auth)
# Generate a 32+ character random secret for production sessions
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
VITE_AUTH_ENABLED=true

# OAuth & Social Sign-In (Optional)
# Configure these if delegating social sign-in to an upstream OAuth broker or provider
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# AI Provider Keys
# Vetta supports an automated fallback ladder across multiple LLM providers:
# Groq -> Gemini -> OpenAI -> Ollama -> xAI
# Set any or all of these keys:
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Local Ollama Configuration (Optional)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
