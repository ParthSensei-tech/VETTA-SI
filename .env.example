# Vetta - Environment Configuration Template

# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Settings
# Leave unset or empty to use local embedded PGLite (WASM Postgres with automatic migrations)
# Set to a standard PostgreSQL connection string for production or external DB (e.g. Neon, Supabase, RDS)
# DATABASE_URL=postgresql://user:password@localhost:5432/vetta

# Authentication Settings (Better Auth)
# Generate a 32+ character random secret for production sessions
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
VITE_AUTH_ENABLED=true

# OAuth & Social Sign-In (Optional)
# Configure these if delegating social sign-in to an upstream OAuth broker or provider
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# AI Provider Keys
# Vetta supports an automated fallback ladder across multiple LLM providers:
# OpenRouter -> Groq -> Gemini -> OpenAI -> Ollama -> xAI
# Set any or all of these keys:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_CREDIT_LIMIT_USD=100.00
OPENROUTER_HARD_LIMIT_USD=95.00
OPENROUTER_WARN_LIMIT_USD=80.00
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Local Ollama Configuration (Optional)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Public site identity (SEO/GEO)
# Canonical origin used for canonical links, sitemap.xml, robots.txt and JSON-LD.
# Set this on deploy so crawlers see the production host even behind proxies.
# Falls back to VITE_PUBLIC_HOSTNAME, then the request host.
# VITE_PUBLIC_SITE_URL=https://vetta.example.com
# VITE_PUBLIC_HOSTNAME=vetta.example.com

# Transactional email (optional)
# Unset means Vetta sends nothing and still completes the request that wanted
# to send it — a founder must never wait on, or lose work to, our SMTP.
RESEND_API_KEY=
RESEND_FROM=

# Lead inbox
# Comma-separated emails allowed on /app/admin-leads besides a workspace owner.
VETTA_ADMIN_EMAILS=

# Razorpay checkout (optional at launch)
# Without these, /pricing's buy button says so plainly and the plan is set up by
# hand. Set all three when live: the webhook secret is what makes a delivery
# genuine, and the webhook is the only thing that flips a plan.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
